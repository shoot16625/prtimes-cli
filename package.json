{
  "name": "prtimes-cli",
  "version": "0.3.0",
  "description": "Unofficial PR TIMES CLI for writing press release drafts from Markdown and checking your releases (for Claude Code, Codex and other AI coding agents)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "prtimes",
    "press-release",
    "skills",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor"
  ],
  "bin": {
    "prtimes-cli": "dist/prtimes-cli.js"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "build": "bun build src/bin.ts --target=bun --outfile=dist/prtimes-cli.js && chmod +x dist/prtimes-cli.js",
    "dev": "bun src/bin.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build && git diff --exit-code -- dist"
  },
  "files": [
    "dist",
    "skills",
    "GEMINI.md",
    "gemini-extension.json",
    ".claude-plugin",
    ".codex-plugin",
    ".agents",
    ".cursor-plugin",
    ".devin-plugin",
    ".kimi-plugin",
    ".antigravity-plugin"
  ],
  "dependencies": {
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
